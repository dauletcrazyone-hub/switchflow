{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwitchFlow",
  "version": "0.1.0",
  "identifier": "app.switchflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SwitchFlow",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#080B12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "SwitchFlow",
    "copyright": "© 2026 SwitchFlow",
    "category": "Utility",
    "resources": { "windows/drivers/UsbDk_x64.msi": "drivers/UsbDk_x64.msi" },
    "shortDescription": "Перенос данных между телефонами",
    "longDescription": "SwitchFlow переносит фото, видео, контакты, календари и файлы между Android и iPhone локально и с шифрованием.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
